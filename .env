# Root env — docker compose reads this automatically for ${VAR} substitution.
# Backend deployment config for the service.pacewisdom.in / serviceapi.pacewisdom.in setup.

# Team timezone. Request windows are naive local times, so this MUST match the
# clock your users see or every scheduled window fires at the wrong time.
TZ=Asia/Kolkata

# Flask session signing.
SECRET_KEY=ull96DDKilLZIGIN2lCyZJ3-5lXvEaeAz6XuWmQzhaufmdYNSILuGveHTfhkZMKr

# Fernet key (urlsafe base64) encrypting cloud credentials and project secrets.
# KEEP IT STABLE — changing it orphans every stored credential.
CRED_KEY=ZPZ-l1ABeXtaHMGTqChuTISdVEu6HMNB8_Bs7J6ncjI=

# Postgres password. Must match the data already in ./pg_data if the volume
# was initialised previously — changing it breaks DB auth against old data.
DB_PASSWORD=evnmanager123

# The SPA is served from service.pacewisdom.in and calls the API cross-origin,
# so CORS must allow that exact origin.
FRONTEND_ORIGIN=https://service.pacewisdom.in

# Served over HTTPS in this deploy, so the session cookie must be Secure.
SESSION_COOKIE_SECURE=1

# First-boot admin (only seeded on a fresh database). CHANGE THE PASSWORD after
# first sign-in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# Set to 1 to plant the mock demo project on first boot.
SEED_DEMO=

# --- Git repo-creation requests ---
# The approver chooses github or gitlab when approving a repo request; only
# providers with a token below are offered. Fill in the ones you use.
# GitHub: token needs 'repo' scope; GITHUB_ORG blank => the token owner's account.
GITHUB_TOKEN=
GITHUB_ORG=
# GitLab: token needs 'api' scope; GITLAB_URL blank => https://gitlab.com;
# GITLAB_NAMESPACE_ID is the numeric group id, blank => the token owner.
GITLAB_TOKEN=
GITLAB_URL=
GITLAB_NAMESPACE_ID=
