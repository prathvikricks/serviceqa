# Frontend build-time config. Vite reads this during `npm run build` (and the
# Docker build copies it in), baking VITE_API_URL into the bundle.
#
# The SPA is hosted at service.pacewisdom.in and talks to the API cross-origin
# at serviceapi.pacewisdom.in. The value MUST include the /api/v1 prefix — the
# client uses it as the full base for every request (e.g. `${BASE}/auth/login`).
VITE_API_URL=https://serviceapi.pacewisdom.in/api/v1
