# Copy to .env and adjust. docker compose reads it automatically.

# Your team's timezone. Request windows are naive local times, so this MUST
# match the clock your users see, or every scheduled window fires at the wrong
# time. e.g. Asia/Kolkata, Europe/London, America/New_York.
TZ=UTC

# Flask session signing. Change for any real deploy.
SECRET_KEY=change-me-in-production

# Fernet key (urlsafe base64) encrypting cloud credentials and project secrets.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev (derived from SECRET_KEY). Once set, KEEP IT STABLE —
# changing it orphans every stored credential.
CRED_KEY=

DB_PASSWORD=evnmanager123

# First-boot admin. Change the password immediately after signing in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# Set to 1 to plant the mock demo project on first boot.
SEED_DEMO=

# Local compose serves plain HTTP, where a browser drops a Secure cookie and
# login silently fails. Leave 0 locally; NEVER set 0 on a real deploy.
SESSION_COOKIE_SECURE=0
